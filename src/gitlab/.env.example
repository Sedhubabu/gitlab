# Copy this file to src/gitlab/.env and fill in the values:
#   cp src/gitlab/.env.example src/gitlab/.env
#
# Never commit the real .env file.

# --- Django core ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
# Comma-separated, no spaces
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# Leave unset to use the local SQLite file (src/db.sqlite3).
# Postgres example:
# DATABASE_URL=postgres://gitlab:gitlab@localhost:5432/gitlab

# --- CORS (React frontend) ---
# Comma-separated list of frontend origins allowed to call the API.
# Vite dev server runs on 5173 by default.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
