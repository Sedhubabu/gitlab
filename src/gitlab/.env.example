# Copy this file to src/gitlab/.env and fill in the values:
#   cp src/gitlab/.env.example src/gitlab/.env
#
# Never commit the real .env file.

# --- Django core ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
# Comma-separated, no spaces
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (PostgreSQL) ---
# The user needs CREATEDB so `manage.py test` can create the test database:
#   sudo -u postgres psql -c "ALTER ROLE gitlab_admin CREATEDB;"
DATABASE_NAME=gitlab
DATABASE_USERNAME=gitlab_admin
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- CORS (React frontend) ---
# Comma-separated list of frontend origins allowed to call the API.
# Vite dev server runs on 5173 by default.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
